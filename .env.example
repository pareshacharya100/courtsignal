# SQLite works without services. For PostgreSQL run docker compose up -d db.
DATABASE_URL=sqlite:///data/courtsignal.db
# DATABASE_URL=postgresql://courtsignal:courtsignal@localhost:5432/courtsignal
DATA_DIR=data

# Optional live RECAP acquisition. Existing public content only; no PACER purchases.
COURTLISTENER_TOKEN=

# Claude is opt-in via the enrich / answer commands. No automatic paid calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Semantic indexing/search is opt-in. Create a 1024-dimensional cosine index.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBEDDING_DIMENSION=1024
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=courtsignal-dev
